{
  "name": "dsh-bili-banghui",
  "version": "0.4.2",
  "private": true,
  "description": "B站帮回：把「回复我的」按人和楼层攒成会话，AI 看对方态度给三条，你点头才发。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/workbench.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/**",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
